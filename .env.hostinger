APP_NAME=LinePharm
APP_ENV=production
APP_KEY=base64:ohcDUQNhZwmfg63rCuqKZpt7MNHly5oUQD+GVdz2WbY=
APP_DEBUG=false
# غيّر هذا لنطاقك الفرعي الفعلي
APP_URL=https://pharmacy.alrt.click

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ===== قاعدة البيانات: SQLite داخل جذر المشروع =====
# نترك DB_DATABASE فاضي → Laravel يستخدم database/database.sqlite تلقائياً
DB_CONNECTION=sqlite
# DB_DATABASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@pharmacy.alrt.click"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
